HOST=127.0.0.1
PORT=7861
COMFYUI_URL=http://127.0.0.1:8188
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# -1 = automatic GPU layer allocation; 0 = CPU; positive values = offloaded layers, not GPU count.
OLLAMA_PROMPT_NUM_GPU=-1
# Release the translator after each call to leave VRAM available for drawing.
OLLAMA_PROMPT_KEEP_ALIVE=0
OUTPUT_DIR=outputs
DATABASE_PATH=data/jobs.sqlite3
CHARACTERS_PATH=config/characters.json
LORA_METADATA_PATH=config/lora_metadata.json
CHECKPOINT_METADATA_PATH=config/checkpoint_metadata.json
PROMPT_PRESETS_PATH=config/prompt_presets.json
PROMPT_KNOWLEDGE_PATH=config/prompt_knowledge.json
COMFYUI_MODELS_DIR=tools/ComfyUI_windows_portable/ComfyUI/models
DEFAULT_CHECKPOINT=waiIllustriousSDXL_v170.safetensors
DEFAULT_STEPS=28
# Local ComfyUI and worker completion polling; does not change cloud claim polling.
GENERATION_POLL_SECONDS=0.5
DEFAULT_CFG=4.5
DEFAULT_SAMPLER=euler
DEFAULT_SCHEDULER=normal
PROMPT_TRANSLATION_TIMEOUT_SECONDS=45
# Entire translation, including the English correction pass.
PROMPT_TRANSLATION_TOTAL_TIMEOUT_SECONDS=45
COMFYUI_TIMEOUT_SECONDS=15

# Cloud worker mode. CLOUD_API_URL should be your cloud backend base URL.
LOCAL_AI_URL=http://127.0.0.1:7861
AI_CONTROL_HOST=127.0.0.1
AI_CONTROL_PORT=7878
AI_CONTROL_TOKEN=
AI_CONTROL_POLL_SECONDS=5
CLOUD_API_URL=
AI_WORKER_TOKEN=
AI_WORKER_ID=local-comfyui-worker
AI_WORKER_NAME=Local ComfyUI Worker
AI_WORKER_VERSION=0.1.0
AI_WORKER_POLL_SECONDS=5
AI_WORKER_CAPABILITY_REPORT_SECONDS=60
AI_WORKER_CLEANUP_OUTPUTS=false

# QQ bot notifications. Startup is sent when this worker process starts;
# message is sent when a cloud job enters this local queue;
# image is sent after the local image file is generated.
QQ_BOT_STARTUP_NOTICE_URL=
QQ_BOT_SHUTDOWN_NOTICE_URL=
QQ_BOT_SEND_MESSAGE_URL=
QQ_BOT_SEND_IMAGE_URL=
QQ_BOT_TOKEN=

# Dual-character generation.
# auto = one shared scene; painted A/B regions supply approximate position hints only.
# mask-conditioning = explicit regional sampling for complete A/B masks.
# regional-area = explicit left/right area conditioning (separate character presentation).
# single-pass = legacy global dual prompts without regional conditioning.
# inpaint = legacy experimental mode: base composition first, then repaint masked regions.
DUAL_CHARACTER_STRATEGY=auto
DUAL_LORA_STRENGTH_CAP=0.65
DUAL_MASK_CONDITIONING_STRENGTH=0.95
DUAL_INPAINT_DENOISE=0.62
DUAL_INPAINT_MASK_OVERLAP_RATIO=0.08
